# Runtime
NODE_ENV=development
API_PORT=13000
WEB_PORT=8080
LOG_LEVEL=debug

# Browser access
CORS_ORIGIN=http://localhost:8080,http://localhost:5173
VITE_API_URL=http://localhost:13000/api/v1
SWAGGER_ENABLED=true
# Public demo only, never on a real installation: sign-in as the seeded
# supervisor without a password, and the data back to the seed on every start.
DEMO_LOGIN=false
DEMO_RESET=false
VITE_DEMO=false

# PostgreSQL (development values only; replace them outside local development)
POSTGRES_DB=faena
POSTGRES_USER=faena_app
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://faena_app:replace_with_a_local_password@localhost:5432/faena?schema=public

# Authentication
JWT_SECRET=replace_with_at_least_32_random_characters
AUTH_COOKIE_SECURE=false
SEED_ADMIN_PASSWORD=replace_with_a_12_character_local_password
SEED_SUPERVISOR_PASSWORD=replace_with_a_12_character_local_password
